{
  "manifest_version": 3,
  "name": "GitLab Jira Label Sync",
  "version": "1.0.0",
  "description": "Sync Jira ticket labels to GitLab merge requests automatically",
  "permissions": ["storage", "activeTab", "tabs", "contextMenus", "notifications"],
  "host_permissions": ["https://*/*"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://*/*/-/merge_requests*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://*/*/-/tree/*", "https://*/*/-/branches*"],
      "js": ["content-branch.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://*.atlassian.net/browse/*"],
      "js": ["content-jira.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
